# Copy to .env and fill in. Vite maps these in vite.config.js, so a new
# variable needs adding there too before the browser can see it.

# OpenRouter key (https://openrouter.ai/keys) — used for chat and embeddings.
OPENAI_API_KEY=sk-or-v1-...

# Must be a model that replies with ordinary message content. Avoid
# openrouter/free: it routes to reasoning models that return an empty
# content, which leaves the app with nothing to parse.
OPENAI_MODEL=openai/gpt-4o-mini

# Optional — this is the default. 1536 dimensions, matching the migration.
EMBED_MODEL=openai/text-embedding-3-small

# Optional — poster art (https://www.omdbapi.com/apikey.aspx).
# Without it the app shows a placeholder instead of a poster.
OMDB_API=...

# Optional — hosted vector search. Without these the app embeds and scores
# the chunks in the browser instead, which works fine for a dozen movies.
# See the README for provisioning the table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
